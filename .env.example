# ── VPS (routing-слой) ──
VPS_PUBLIC_IP=xxx.xxx.xxx.xxx      # публичный IP VPS; A-запись домена
VPS_TAILSCALE_IP=100.x.x.x

# ── NAS (backend за Tailscale) ──
NAS_TAILSCALE_IP=100.x.x.x         # Caddy форвардит запросы сюда

# ── Домен / TLS ──
BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com         # email для регистрации Let's Encrypt

# ── tinyproxy ──
TINYPROXY_PORT=8888

# ── Tailscale ──
TS_AUTHKEY=tskey-auth-xxxxx        # одноразовый ключ регистрации VPS в tailnet