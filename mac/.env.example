# ── Мак: SwiftBar-плагин mac/swiftbar/nas.5m.sh ──

BASE_DOMAIN=example.com            # домен (как в vps/.env на VPS)
NAS_TAILSCALE_IP=100.x.x.x         # NAS в tailnet (как в vps/.env на VPS)
NAS_LAN_IP=192.168.x.x            # NAS в домашней сети
NAS_LAN_MAC=                      # MAC LAN-порта NAS (DSM → Сеть → Сетевой интерфейс); пусто — без проверки MAC
NAS_LAN_NAME=HomeNas              # имя из /etc/hosts для LAN-адреса (подпись в сайдбаре Finder); пусто — по IP
NAS_TAIL_NAME=HomeNasTS           # то же для tailnet-адреса
SMB_SHARES="share1 share2"        # SMB-папки в меню, через пробел
CADDY_PORT=8444                   # порт Caddy на VPS
TG_PROXY_PORT=xxxx                # TG-прокси на VPS
